# How this app reaches the TrustedHands API. Use ONE of:
#
# 1. Proxy (recommended for deployment): the browser calls /v1/* on this app's
#    own origin and Next forwards it to the API. The app and API can be on any
#    domains. Use the API's private/internal URL when the host offers one.
# API_ORIGIN="https://trustedhands-api.onrender.com"
#
# 2. Direct (local development): the browser calls the API itself. The app and
#    API must be same-site (localhost ports, or sibling subdomains) so the
#    httpOnly refresh cookie is sent.
NEXT_PUBLIC_API_URL="http://localhost:3000"
#
# Either way, this app's public origin must be in the API's CORS_ORIGINS
# (the API checks Origin on the cookie endpoints).
